generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  numero    String?
  endereco  String?
  complemento String?
  cpf       String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  cars      Car[]
}

model Car {
  id             Int             @id @default(autoincrement())
  brand          String?
  model          String?
  plate          String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  userId         Int?
  year           Int?
  color          String?
  user           User?           @relation(fields: [userId], references: [id])
  slots          CarSlot[]
  parkingRecords ParkingRecord[]
}

model CarSlot {
  id             Int             @id @default(autoincrement())
  price          Decimal
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  carId          Int?
  car            Car?            @relation(fields: [carId], references: [id])
  parkingRecords ParkingRecord[]
}

model ParkingRecord {
  id        Int       @id @default(autoincrement())
  entryTime DateTime  @default(now())
  exitTime  DateTime?
  price     Decimal?
  carId     Int
  slotId    Int
  car       Car       @relation(fields: [carId], references: [id])
  slot      CarSlot   @relation(fields: [slotId], references: [id])
}
